(assert! true)

(: opBox (call BoxType.construct (symbol "my-box")))

(do
 (assert! (== (typeof opBox) BoxType))
 (: toBox (symbol "+"))

 (: boxedOp (call opBox.construct toBox))

 (assert! (== (typeof boxedOp) opBox))
 (assert! (== boxedOp.unbox toBox))
)

(do
 (assert! (== (to-expr BoxType) (symbol "BoxType")))
 (assert! (== (to-expr opBox) (expr (BoxType (symbol "my-box")))))
 (assert! (==
    (to-expr (call opBox.construct (symbol "+")))
    (expr ((BoxType (symbol "my-box")) (symbol "+")))
 ))
)
