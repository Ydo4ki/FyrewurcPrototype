(assert! true)

(do
 // looking up println method
 (: println! (do
  (: System (invoke! (call _JvmEnv.find-type "Ljava/lang/System;")))
  (: outGetter (call System.get-static-getter "out" "Ljava/io/PrintStream;"))
  (: out (outGetter))
  (call out.get-method "println" "(Ljava/lang/String;)V")
 ))

 // creating string
 (: String (invoke! (call _JvmEnv.find-type "Ljava/lang/String;")))
 (: string-ctor (call String.get-constructor "([C)V"))
 (: ca-ctor (invoke! (call _JvmEnv.find-array-constructor "C")))
 (: ca-setter (invoke! (call _JvmEnv.find-array-setter "[C")))
 (: ca (ca-ctor (jint 12)))
 (ca-setter ca (jint 0) (jchar 'H'))
 (ca-setter ca (jint 1) (jchar 'e'))
 (ca-setter ca (jint 2) (jchar 'l'))
 (ca-setter ca (jint 3) (jchar 'l'))
 (ca-setter ca (jint 4) (jchar 'o'))
 (ca-setter ca (jint 5) (jchar ' '))
 (ca-setter ca (jint 6) (jchar 'W'))
 (ca-setter ca (jint 7) (jchar 'o'))
 (ca-setter ca (jint 8) (jchar 'r'))
 (ca-setter ca (jint 9) (jchar 'l'))
 (ca-setter ca (jint 10) (jchar 'd'))
 (ca-setter ca (jint 11) (jchar '!'))
 (: text (string-ctor ca))

 // the printing part
 (println! text)
)



(: get-property! (do
 (: System (invoke! (call _JvmEnv.find-type "Ljava/lang/System;")))
 (: getProperty! (call System.get-static-method "getProperty" "(Ljava/lang/String;)Ljava/lang/String;"))

 (fn [(= prop)] !> (call _JvmEnv.jstring2str (getProperty! (call _JvmEnv.str2jstring prop))))
))

DQWord
0x01F4

(do
 (println! "Hello World Test 2!!!")

 (println! (+ "Java Version: " (get-property! "java.version")))
 (println! (+ "Vendor: " (get-property! "java.vendor")))
 (println! (+ "Spec Version: " (get-property! "java.specification.version")))
 (println! (+ "Spec Vendor: " (get-property! "java.specification.vendor")))

 (: Thread (invoke! (call _JvmEnv.find-type "Ljava/lang/Thread;")))
 (: threadSleep! (call Thread.get-static-method "sleep" "(J)V"))
 (threadSleep! (jlong 500))

 (println! (+ "OS: " (get-property! "os.name") " " (get-property! "os.arch") " " (get-property! "os.version")))

 (println! (+ "User: " (get-property! "user.name")))
 (println! (+ "User path: " (get-property! "user.home")))
 (println! (+ "Working directory: " (get-property! "user.dir")))

 (: System (invoke! (call _JvmEnv.find-type "Ljava/lang/System;")))
 (: exit! (call System.get-static-method "exit" "(I)V"))
 (exit! (jint 1))
)