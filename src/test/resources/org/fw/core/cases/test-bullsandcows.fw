 (slowprint! "Welcome! Enter amount of digits to guess:\n")

 (: digits (read-digits!))

// (: number (generate-number digits (invoke! _NanoTime)))
// (print! number)
 (print! "\n")

 (slowprint! "Number guessed, now try to guess it.
The output will indicate how far are you from the number:
a bull means that your guess contains a correct digit in a right place,
a cow means that your guess contains a correct digit in a wrong place\n")



 (slowprint! (call expr2str (to-expr digits)))
 (print! "\n")
)
