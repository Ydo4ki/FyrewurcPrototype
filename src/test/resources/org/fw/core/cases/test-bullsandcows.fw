(do
 (: sleep! (fn [(= millis)] !>
  (invoke! (call _Sleep millis))))
 (: print! (fn [(= str)] !>
  (invoke! (call _Print str))))
 (: readline! (fn [] !>
  (invoke! _ReadLine)))
 (: to-expr (fn [(= x)] ->
  (call (var) (symbol "to-expr") x)))
 (: < (fn [(= a) (= b)] ->
  (call eq (<=> a b) -1)))
 (: > (fn [(= a) (= b)] ->
  (call eq (<=> a b) 1)))
 (: == (fn [(= a)(= b)] ->
  (call eq a b)))
 (: typeof (fn [(= x)] ->
  (call type-get x)))

 (: slowprint! (fn [(= string)] !> (do
      (: i (new! 0))

      (while (< (read! i) string.size) (do
       (: s (read! i))
       (: e (+ s 1))

       (print! (call string.sub s e))
       (sleep! 20)
       (write! i (+ (read! i) 1))
      ))
      unit
 )))

 (: read-digits! (fn [] !> (do (: read-digits! (get (var) %self%))
  (: digits (call DInt.parse (readline!)))
  (: valid (== (typeof digits) DInt))
  (if (not valid) (do
   (slowprint! "Invalid input :( Try again:\n")
   (read-digits!)
  ) else digits)
 )))

