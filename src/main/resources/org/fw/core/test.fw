(call 5 (symbol "+") 5)

(call Module.constructor [
    (call Declared.builder (symbol "use-comp-env") 0)
    (: zero 0)
])
// (usec <CEnv> <...>) // use a comp env on top of your current cenv stack
// (usem <Module> <...>) // use a module as comp env (basially import)
// (telephonize <val>) // erase type information (wrap with telephonist that behaves exactly the same, basically x -> (telephonist arg (call x arg)))

test-mod.test-value
(usem test-mod
    test-value
)
(usec (call ModuleCompEnv.constructor test-mod)
    test-value
)

