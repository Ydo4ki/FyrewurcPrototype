(assert! true)

// operations on single bits
(do
 (assert! (== (~ b1) b0))
 (assert! (== (~ b0) b1))

 (assert! (== (| b0 b0) b0))
 (assert! (== (| b0 b1) b1))
 (assert! (== (| b1 b0) b1))
 (assert! (== (| b1 b1) b1))

 (assert! (== (& b0 b0) b0))
 (assert! (== (& b0 b1) b0))
 (assert! (== (& b1 b0) b0))
 (assert! (== (& b1 b1) b1))

 (assert! (== (^ b0 b0) b0))
 (assert! (== (^ b0 b1) b1))
 (assert! (== (^ b1 b0) b1))
 (assert! (== (^ b1 b1) b0))

 (assert! (== (~| b0 b0) b1))
 (assert! (== (~| b0 b1) b0))
 (assert! (== (~| b1 b0) b0))
 (assert! (== (~| b1 b1) b0))

 (assert! (== (~& b0 b0) b1))
 (assert! (== (~& b0 b1) b1))
 (assert! (== (~& b1 b0) b1))
 (assert! (== (~& b1 b1) b0))

 (assert! (== (~^ b0 b0) b1))
 (assert! (== (~^ b0 b1) b0))
 (assert! (== (~^ b1 b0) b0))
 (assert! (== (~^ b1 b1) b1))
)

(do
 (: x b01111)
 (invoke! (call _Print (~ x)))
 (invoke! (call _Print x))
)

(do
 (: a b11111111)
 (: b b11110111)


 (call bitnot Octet (call bitxor Octet a b))
// (call eq (ReifiedType Bit 8) Octet)

