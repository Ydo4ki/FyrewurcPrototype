(do
 (: a (call Octet.builder b1 b1 b1 b1 b1 b1 b1 b1))
 (: b (call Octet.builder b1 b1 b1 b1 b0 b1 b1 b1))


 (call bitnot Octet (call bitxor Octet a b))
 (call eq (call ReifiedType.builder Bit 8) Octet)
