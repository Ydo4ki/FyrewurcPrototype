(Test
    (== (VitVal 14) (call (get VitVal constructor) 14))
    (== (get (VitVal 14) val) 14)
    (== (call type-get (VitVal 14)) VitVal)
)

(Test
    (== (VitVar) (get VitVar instance))
    (== (call type-get (VitVar)) VitVar)
)

(Test
    (==
        (VitCall (VitVal 14) (VitVal (Symbol "+")))
        (call (get VitCall builder) (VitVal 14) (VitVal (Symbol "+"))))

    (==
        (get (VitCall (VitVal 14) (VitVal (Symbol "+"))) func)
        (VitVal 14))

    (==
        (get (VitCall (VitVal 14) (VitVal (Symbol "+"))) arg)
        (VitVal (Symbol "+")))

    (==
        (call type-get (VitCall (VitVal 14) (VitVal (Symbol "+"))))
        VitCall)
)


