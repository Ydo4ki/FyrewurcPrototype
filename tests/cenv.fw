// 
// so I didn't need to add anything
// I just needed to figure out how my own api works


(Test
    (== (invoke! (call eval
        (call comp-env (call (get SyntaxResolve builder)
            (expr
                (+ 81 4)
            )
            comp-env
        ))
        unspecified
    )) 85)
)

(Test
    (== (invoke! (call eval
        (call comp-env (call (get SyntaxResolve builder)
            (expr
                (+ 81 (get (var) arg))
            )
            comp-env
        ))
        (Module
            (: arg 4)
        )
    )) 85)
)

