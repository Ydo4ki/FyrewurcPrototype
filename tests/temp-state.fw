(: mirror (telephonist arg arg))
(: o (_Object 50))
(get! o) -> (VitInvoke (ReadOperation o))
(get! o) -> (VitInvoke (VitCall ReadOperation (Symbol "constructor") o))
(get! (call mirror o)) -> (VitInvoke (VitCall ReadOperation (Symbol "constructor") (VitCall mirror o)))

