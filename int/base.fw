(: ? (call Constraint.builder (VitVar) (VitVar)))

(: FunctionPayload (Struct [
    (= params ?)
    (= body ?)
    (= rt-env ?)
]))

(: Call (jval "base.Call" "call_t"))


(: DInt (typeof 0))
(: Str (typeof ""))

//(: errs (jincludeval "errs.fw"))

// todo: as let is currently a macro it redefines (get (var) this)
//  so you can make a recursion out of let
//  which is not bad
//  what is bad though is that nobody would expect a (get (var) this) to give us current let instead of current telephonist
//  so you shall fix this somehow (probably just by making let a normal function and not a macro)
(: Function (jincludeval "Function.fw"))

(: CompEnv (jval "lib.expr.CompEnv" "compEnv"))

(: fn (telephonist arg
    (if
        (and (== (typeof arg) ExprCallOp) (== arg.size 3) (== (call arg 1) (Symbol "!>")))
        (let cenv arg.comp-env
            (let bcenv (call CompEnv.builder (telephonist sr
//                (if (== (typeof sr) SyntaxResolve)
//                    (if (== sr.expr (Symbol "rt"))
//                        (VitVal "memememmememe")
//                        unspecified
//                        unspecified
//                    )
                    unspecified
//                )
            ) cenv) (VitCall
                    (VitVal Function)
                    (VitVal (Symbol "constructor"))
                    (VitCall
                        (VitVal FunctionPayload)
                        (VitVal (Symbol "builder"))
                        (call cenv (SyntaxResolve (call arg 0) cenv))
                        (VitVal (call (SyntaxResolve (call arg 2) bcenv)))
                        (VitVar)
                    )
                )
            )
        )
        unspecified
    )
))

