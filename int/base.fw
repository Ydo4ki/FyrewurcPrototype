(: or (ExprAccumulator (Symbol "or")))
(: and (ExprAccumulator (Symbol "and")))
(: xor (ExprAccumulator (Symbol "xor"))) // it doesn't concern you

(: true (call eq 0 0))
(: false (not true))
(: Bool (typeof true))

