(: operation (jval "lib.state.OperationFw" "operationExpr"))

(: unit (jval "state.operation.Operation" "unit"))

(: unspecified (jval "base.Val" "unspecified"))


(: if (telephonist arg
    (call
        (get (and (call eq (typeof arg) ExprCallOp) (call eq arg.size 3)) if)
        (call (telephonist cenv
            (VitInvoke (VitCall
                (VitVal eval)
                (VitCall
                    (call cenv (SyntaxResolve (call arg 0) cenv))
                    (VitVal (Symbol "if"))
                    (VitVal (call cenv (SyntaxResolve (call arg 1) cenv)))
                    (VitVal (call cenv (SyntaxResolve (call arg 2) cenv)))
                )
                (VitVar)
            ))
        ) arg.comp-env)
        unspecified
    )
))

(: compile-vit (telephonist arg
    (if (call eq (typeof arg) ExprCallOp)
        (if (call eq arg.size 1)
            (VitVal (call arg.comp-env (SyntaxResolve (call arg 0) arg.comp-env)))
            "One argument expected"
        )
        unspecified
//        (if (call eq arg.size 2)
//            unspecified // nevermind.
//            unspecified
//        )
    )
))

(: let (telephonist arg
    (if (and (call eq (typeof arg) ExprCallOp) (call eq arg.size 3))
        (call (telephonist cenv
            (VitInvoke (call cenv (call SyntaxResolve.builder
                (ExprList
                    (Symbol "call")
                    (ExprList
                        (Symbol "telephonist")
                        (call arg 0)
                        (ExprList
                            (Symbol "operation")
                            (call arg (- arg.size 1))
                        )
                    )
                    (call arg 1)
                )
                cenv
            )))
        ) arg.comp-env)
        unspecified
    )
))

// todo: allow multiple arguments
(: == (telephonist arg
    (if
        (and (call eq (typeof arg) ExprCallOp) (call eq arg.size 2))
        (let cenv arg.comp-env
            (VitCall
                (VitVal eq)
                (call cenv (SyntaxResolve (call arg 0) cenv))
                (call cenv (SyntaxResolve (call arg 1) cenv))
            )
        )
        unspecified
    )
))
(: != (telephonist arg
    (if
        (and (call eq (typeof arg) ExprCallOp) (call eq arg.size 2))
        (let cenv arg.comp-env
            (VitCall
                (VitVal eq)
                (call cenv (SyntaxResolve (call arg 0) cenv))
                (call cenv (SyntaxResolve (call arg 1) cenv))
                (VitVal (Symbol "not"))
            )
        )
        unspecified
    )
))





(: toExpr (BoxType (Symbol "to-expr")))
(: to-expr (telephonist %0
    (call (typeof %0) (toExpr %0))))

(: do (jval "lib.expr.DoFw" "_do"))
(: Struct (jval "lib.StructFw" "struct"))
(: ErrType (jval "lib.ErrTypeFw" "errType"))
(: Enum (jval "lib.EnumFw" "enumeration"))

(: Purity (Enum [(Symbol "Pure") (Symbol "Dirty")]))
(: StaticSignature (Struct [
    (= parameters DVec) // (Array Constraint)
    (= result true) // Constraint
]))
(: FnTypePayload (Struct [
    (= signature StaticSignature)
    (= purity Purity)
]))
(: FnType (telephonist arg
    unspecified
))

