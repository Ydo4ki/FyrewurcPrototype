(: ExprList (typeof (expr [])))


// boolean
(: not (ExprSender (Symbol "not")))

// todo: implement them independently that way that there won't be any unnecessary evaluations
(: or (ExprAccumulator (Symbol "or")))
(: and (ExprAccumulator (Symbol "and")))
(: xor (ExprAccumulator (Symbol "xor"))) // it doesn't concern you

(: true (call eq 0 0))
(: false (not true))
(: Bool (typeof true))

(: + (ExprAccumulator (Symbol "+")))
(: - (ExprAccumulator (Symbol "-")))
(: * (ExprAccumulator (Symbol "*")))
(: / (ExprAccumulator (Symbol "/")))
(: % (ExprAccumulator (Symbol "%")))

