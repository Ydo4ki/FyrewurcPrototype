(do
 (invoke! (call _Print "Enter Your Name:\n"))
 (: name (invoke! _ReadLine))
 (invoke! (call _Print "Hi, "))
 (invoke! (call _Print name))
 (invoke! (call _Print "\n"))
 (invoke! (call _Sleep 1000))
 (invoke! (call _Print "We're getting everything ready for you\n"))
 (invoke! (call _Sleep 10000))
 (invoke! (call _Print "Almost there\n"))
 (invoke! (call _Sleep 3000))
 (invoke! (call _Print "Ah\n"))
 (invoke! (call _Sleep 100))
 (invoke! (call _Print "Error"))

 (: i (invoke! (call _CreateNewObjectOperation 0)))

 (while (call eq (<=> (read! i) 10) -1) (do
  (invoke! (call _Sleep 500))
  (invoke! (call _Print "0"))
  (write! i (+ (read! i) 1))
 ))

 (invoke! (call _Print "\nStop\n"))
 (invoke! (call _Print "Please reinstall\n"))
)
