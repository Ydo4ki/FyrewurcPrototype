(assert! true)

(: v1 (new! unit))
(: v2 (new! unit))
(: c1 (call VitVal.construct v1))
(: c2 (call VitVal.construct v2))

(do
 (assert! (== c1.val v1))

 (do
  (: vit (call VitCall.builder c1 c2))

  (assert! (== vit.func.val v1))
  (assert! (== vit.arg.val v2))
 )

 (do
  (: codeThatCreatesVit (compile-vit (call VitCall.builder c1 c2)))
  (: vit (call eval-vit codeThatCreatesVit unit))

  (assert! (== vit.func.val v1))
  (assert! (== vit.arg.val v2))
 )
)

(do
 (assert! (==
  (call VitCall.builder (call VitVal.construct 14) (call VitVal.construct (symbol "+")))
  (call VitCall.builder (call VitVal.construct 14) (call VitVal.construct (symbol "+")))))

 (assert! (==
  (get (call VitCall.builder (call VitVal.construct 14) (call VitVal.construct (symbol "+"))) func)
  (call VitVal.construct 14)))

 (assert! (==
   (get (call VitCall.builder (call VitVal.construct 14) (call VitVal.construct (symbol "+"))) arg)
   (call VitVal.construct (symbol "+"))))

 (assert! (== (typeof (call VitCall.builder (call VitVal.construct 14) (call VitVal.construct (symbol "+")))) VitCall))
)

(do
 (assert! (== (to-expr VitVal) (symbol "VitVal")))
 (assert! (== (to-expr VitVar) (symbol "VitVar")))
 (assert! (== (to-expr VitCall) (symbol "VitCall")))
 (assert! (== (to-expr VitInvoke) (symbol "VitInvoke")))

 (assert! (== (to-expr (call VitVal.construct false)) (expr (VitVal false))))
 (assert! (==
  (to-expr (call VitCall.builder (call VitVal.construct false) (call VitVal.construct true)))
  (expr (VitCall (VitVal false) (VitVal true)))))
)