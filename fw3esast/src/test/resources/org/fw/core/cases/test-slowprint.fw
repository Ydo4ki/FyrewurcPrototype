(do
 (: sleep! (fn [(= millis)] !>
  (invoke! (call _Sleep millis))))
 (: print! (fn [(= str)] !>
  (invoke! (call _Print str))))

 (: slowprint! (fn [(= string)] !> (do
      (: i (new! 0))

      (invoke! (call _While (operation (call eq (call (read! i) (symbol "<=>") string.size) -1)) (operation (do
       (: s (read! i))
       (: e (call s (symbol "+") 1))

       (print! (call string.sub s e))
       (sleep! 100)
       (write! i (call (read! i) (symbol "+") 1))
      ))))
 )))

// (invoke! (call _Print (call (var) (symbol "to-expr") slowprint!)))
 (invoke! (call slowprint!.fn-call ["Hi.\n"]))
 (sleep! 500)
 (slowprint! "This is slowprint test.\n")
 (sleep! 500)
 (slowprint! "Feel free to join.\n")
)

