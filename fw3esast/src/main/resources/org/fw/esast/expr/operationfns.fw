(module
 (: new! (fn [(= x)] !>
  (invoke! (call (get (invoke! StatePointer.current) scope new) x))))
 (: read! (fn [(= o)] !>
  (invoke! o.read)))
 (: write! (fn [(= o) (= x)] !>
  (invoke! (call o.write x))))

 (: == (fn [(= a)(= b)] ->
  (call eq a b)))
 (: != (fn [(= a)(= b)] ->
  (not (call eq a b))))
)
